#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56f063faf490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56f063faf620 .scope module, "half_addder_tb" "half_addder_tb" 3 2;
 .timescale -9 -12;
v0x56f063ffcaa0_0 .var "A", 0 0;
v0x56f063ffcb60_0 .var "B", 0 0;
v0x56f063ffcc30_0 .net "Carry", 0 0, L_0x56f063ffcf60;  1 drivers
v0x56f063ffcd30_0 .net "Sum", 0 0, L_0x56f063ffce00;  1 drivers
S_0x56f063fe8ce0 .scope module, "dut" "half_adder" 3 7, 4 2 0, S_0x56f063faf620;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Sum";
    .port_info 3 /OUTPUT 1 "Carry";
L_0x56f063ffce00 .functor XOR 1, v0x56f063ffcaa0_0, v0x56f063ffcb60_0, C4<0>, C4<0>;
L_0x56f063ffcf60 .functor AND 1, v0x56f063ffcaa0_0, v0x56f063ffcb60_0, C4<1>, C4<1>;
v0x56f063fe8f30_0 .net "A", 0 0, v0x56f063ffcaa0_0;  1 drivers
v0x56f063ffc800_0 .net "B", 0 0, v0x56f063ffcb60_0;  1 drivers
v0x56f063ffc8c0_0 .net "Carry", 0 0, L_0x56f063ffcf60;  alias, 1 drivers
v0x56f063ffc960_0 .net "Sum", 0 0, L_0x56f063ffce00;  alias, 1 drivers
    .scope S_0x56f063faf620;
T_0 ;
    %vpi_call/w 3 15 "$dumpfile", "half_adder.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56f063faf620 {0 0 0};
    %vpi_call/w 3 17 "$monitor", "Time=%0t | A=%b B=%b | Sum=%b Carry=%b", $time, v0x56f063ffcaa0_0, v0x56f063ffcb60_0, v0x56f063ffcd30_0, v0x56f063ffcc30_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56f063ffcaa0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56f063ffcb60_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56f063ffcaa0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56f063ffcb60_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56f063ffcaa0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56f063ffcb60_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56f063ffcaa0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56f063ffcb60_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "half_addder_tb.v";
    "half_adder.v";
