#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5de52dc39490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5de52dc39620 .scope module, "half_addder_tb" "half_addder_tb" 3 1;
 .timescale 0 0;
v0x5de52dc86a80_0 .var "A", 0 0;
v0x5de52dc86b40_0 .var "B", 0 0;
v0x5de52dc86c10_0 .net "Carry", 0 0, L_0x5de52dc86f40;  1 drivers
v0x5de52dc86d10_0 .net "Sum", 0 0, L_0x5de52dc86de0;  1 drivers
S_0x5de52dc72ce0 .scope module, "dut" "half_adder" 3 6, 4 2 0, S_0x5de52dc39620;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Sum";
    .port_info 3 /OUTPUT 1 "Carry";
L_0x5de52dc86de0 .functor XOR 1, v0x5de52dc86a80_0, v0x5de52dc86b40_0, C4<0>, C4<0>;
L_0x5de52dc86f40 .functor AND 1, v0x5de52dc86a80_0, v0x5de52dc86b40_0, C4<1>, C4<1>;
v0x5de52dc72f30_0 .net "A", 0 0, v0x5de52dc86a80_0;  1 drivers
v0x5de52dc867e0_0 .net "B", 0 0, v0x5de52dc86b40_0;  1 drivers
v0x5de52dc868a0_0 .net "Carry", 0 0, L_0x5de52dc86f40;  alias, 1 drivers
v0x5de52dc86940_0 .net "Sum", 0 0, L_0x5de52dc86de0;  alias, 1 drivers
    .scope S_0x5de52dc39620;
T_0 ;
    %vpi_call/w 3 14 "$dumpfile", "half_adder.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5de52dc39620 {0 0 0};
    %vpi_call/w 3 16 "$monitor", "Time=%0t | A=%b B=%b | Sum=%b Carry=%b", $time, v0x5de52dc86a80_0, v0x5de52dc86b40_0, v0x5de52dc86d10_0, v0x5de52dc86c10_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5de52dc86a80_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5de52dc86b40_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5de52dc86a80_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5de52dc86b40_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5de52dc86a80_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5de52dc86b40_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5de52dc86a80_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5de52dc86b40_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 24 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "half_addder_tb.v";
