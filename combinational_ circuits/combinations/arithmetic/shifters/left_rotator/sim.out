#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x655327e48bb0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x655327e48d40 .scope module, "left_rotator_tb" "left_rotator_tb" 3 2;
 .timescale -9 -12;
v0x655327e5bb50_0 .var "a", 3 0;
v0x655327e5bc40_0 .net "y", 3 0, L_0x655327e5bed0;  1 drivers
S_0x655327e0f490 .scope module, "dut" "left_rotator" 3 6, 4 1 0, S_0x655327e48d40;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /OUTPUT 4 "y";
v0x655327e0f670_0 .net *"_ivl_1", 2 0, L_0x655327e5bd10;  1 drivers
v0x655327e5b870_0 .net *"_ivl_3", 0 0, L_0x655327e5be30;  1 drivers
v0x655327e5b950_0 .net "a", 3 0, v0x655327e5bb50_0;  1 drivers
v0x655327e5ba10_0 .net "y", 3 0, L_0x655327e5bed0;  alias, 1 drivers
L_0x655327e5bd10 .part v0x655327e5bb50_0, 0, 3;
L_0x655327e5be30 .part v0x655327e5bb50_0, 3, 1;
L_0x655327e5bed0 .concat [ 1 3 0 0], L_0x655327e5be30, L_0x655327e5bd10;
    .scope S_0x655327e48d40;
T_0 ;
    %vpi_call/w 3 12 "$dumpfile", "left_rotator.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x655327e48d40 {0 0 0};
    %vpi_call/w 3 14 "$monitor", "$time=%0t | a=%b | y=%b", $time, v0x655327e5bb50_0, v0x655327e5bc40_0 {0 0 0};
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x655327e5bb50_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x655327e5bb50_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x655327e5bb50_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 13, 0, 4;
    %store/vec4 v0x655327e5bb50_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "left_rotator_tb.v";
    "left_rotator.v";
