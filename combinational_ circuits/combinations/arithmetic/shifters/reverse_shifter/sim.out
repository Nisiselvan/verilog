#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5d6d906e8da0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5d6d906e8f30 .scope module, "reverse_shifter_tb" "reverse_shifter_tb" 3 3;
 .timescale -9 -12;
v0x5d6d906fd330_0 .var "a", 3 0;
v0x5d6d906fd3f0_0 .net "y", 3 0, L_0x5d6d906fd850;  1 drivers
S_0x5d6d906af490 .scope module, "dut" "reverse_shifter" 3 8, 4 1 0, S_0x5d6d906e8f30;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /OUTPUT 4 "y";
v0x5d6d906af670_0 .net *"_ivl_1", 0 0, L_0x5d6d906fd4c0;  1 drivers
v0x5d6d906fce40_0 .net *"_ivl_3", 0 0, L_0x5d6d906fd5e0;  1 drivers
v0x5d6d906fcf20_0 .net *"_ivl_5", 0 0, L_0x5d6d906fd680;  1 drivers
v0x5d6d906fcfe0_0 .net *"_ivl_7", 0 0, L_0x5d6d906fd750;  1 drivers
v0x5d6d906fd0c0_0 .net "a", 3 0, v0x5d6d906fd330_0;  1 drivers
v0x5d6d906fd1f0_0 .net "y", 3 0, L_0x5d6d906fd850;  alias, 1 drivers
L_0x5d6d906fd4c0 .part v0x5d6d906fd330_0, 0, 1;
L_0x5d6d906fd5e0 .part v0x5d6d906fd330_0, 1, 1;
L_0x5d6d906fd680 .part v0x5d6d906fd330_0, 2, 1;
L_0x5d6d906fd750 .part v0x5d6d906fd330_0, 3, 1;
L_0x5d6d906fd850 .concat [ 1 1 1 1], L_0x5d6d906fd750, L_0x5d6d906fd680, L_0x5d6d906fd5e0, L_0x5d6d906fd4c0;
    .scope S_0x5d6d906e8f30;
T_0 ;
    %vpi_call/w 3 14 "$dumpfile", "reverse_shifter.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5d6d906e8f30 {0 0 0};
    %vpi_call/w 3 17 "$monitor", "time=%0t | a=%b | y=%b", $time, v0x5d6d906fd330_0, v0x5d6d906fd3f0_0 {0 0 0};
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5d6d906fd330_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5d6d906fd330_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5d6d906fd330_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 13, 0, 4;
    %store/vec4 v0x5d6d906fd330_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x5d6d906fd330_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5d6d906fd330_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 26 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "reverse_shifter_tb.v";
    "reverse_shifter.v";
