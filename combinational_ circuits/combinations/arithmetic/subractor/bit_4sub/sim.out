#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x60b411853630 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x60b411866c00 .scope module, "bit_4sub_tb" "bit_4sub_tb" 3 2;
 .timescale -9 -12;
v0x60b411879bb0_0 .var "a", 3 0;
v0x60b411879ca0_0 .var "b", 3 0;
v0x60b411879d70_0 .net "diff", 3 0, L_0x60b411879e70;  1 drivers
S_0x60b411866d90 .scope module, "dut" "bit_4sub" 3 5, 4 2 0, S_0x60b411866c00;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 4 "b";
    .port_info 2 /OUTPUT 4 "diff";
v0x60b411866fc0_0 .net "a", 3 0, v0x60b411879bb0_0;  1 drivers
v0x60b411879990_0 .net "b", 3 0, v0x60b411879ca0_0;  1 drivers
v0x60b411879a70_0 .net "diff", 3 0, L_0x60b411879e70;  alias, 1 drivers
L_0x60b411879e70 .arith/sub 4, v0x60b411879bb0_0, v0x60b411879ca0_0;
    .scope S_0x60b411866c00;
T_0 ;
    %vpi_call/w 3 8 "$dumpfile", "bit_4sub.vcd" {0 0 0};
    %vpi_call/w 3 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x60b411866c00 {0 0 0};
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x60b411879bb0_0, 0, 4;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x60b411879ca0_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 10 "$display", "a=%d b=%d diff=%d", v0x60b411879bb0_0, v0x60b411879ca0_0, v0x60b411879d70_0 {0 0 0};
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x60b411879bb0_0, 0, 4;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x60b411879ca0_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 11 "$display", "a=%d b=%d diff=%d", v0x60b411879bb0_0, v0x60b411879ca0_0, v0x60b411879d70_0 {0 0 0};
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x60b411879bb0_0, 0, 4;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x60b411879ca0_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 12 "$display", "a=%d b=%d diff=%b", v0x60b411879bb0_0, v0x60b411879ca0_0, v0x60b411879d70_0 {0 0 0};
    %vpi_call/w 3 13 "$finish" {0 0 0};
    %end;
    .thread T_0;
