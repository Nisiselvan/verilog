#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5b8d69348c20 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5b8d69348db0 .scope module, "xs3_to_bcd_tb" "xs3_to_bcd_tb" 3 2;
 .timescale -9 -12;
v0x5b8d6935cba0_0 .net "bcd", 3 0, v0x5b8d6930f690_0;  1 drivers
v0x5b8d6935cc60_0 .var "xs3", 3 0;
S_0x5b8d6930f490 .scope module, "dut" "xs3_to_bcd" 3 6, 4 1 0, S_0x5b8d69348db0;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "xs3";
    .port_info 1 /OUTPUT 4 "bcd";
v0x5b8d6930f690_0 .var "bcd", 3 0;
v0x5b8d6935ca60_0 .net "xs3", 3 0, v0x5b8d6935cc60_0;  1 drivers
E_0x5b8d6930fa10 .event anyedge, v0x5b8d6935ca60_0;
    .scope S_0x5b8d6930f490;
T_0 ;
    %wait E_0x5b8d6930fa10;
    %load/vec4 v0x5b8d6935ca60_0;
    %subi 3, 0, 4;
    %store/vec4 v0x5b8d6930f690_0, 0, 4;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5b8d69348db0;
T_1 ;
    %vpi_call/w 3 11 "$dumpfile", "xs3_to_bcd.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5b8d69348db0 {0 0 0};
    %vpi_call/w 3 14 "$monitor", "Time=%0t | XS3=%b | BCD=%b", $time, v0x5b8d6935cc60_0, v0x5b8d6935cba0_0 {0 0 0};
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x5b8d6935cc60_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 27 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "xs3_to_bcd_tb.v";
    "xs3_to_bcd.v";
