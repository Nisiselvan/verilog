#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x57a05a5d45b0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x57a05a5e7bb0 .scope module, "equality_tb" "equality_tb" 3 1;
 .timescale 0 0;
v0x57a05a5fa3d0_0 .var "A", 3 0;
v0x57a05a5fa4c0_0 .var "B", 3 0;
v0x57a05a5fa590_0 .net "EQ", 0 0, L_0x57a05a5fa690;  1 drivers
S_0x57a05a5e7d40 .scope module, "dut" "equality" 3 4, 4 1 0, S_0x57a05a5e7bb0;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "A";
    .port_info 1 /INPUT 4 "B";
    .port_info 2 /OUTPUT 1 "EQ";
v0x57a05a5e7f70_0 .net "A", 3 0, v0x57a05a5fa3d0_0;  1 drivers
v0x57a05a5fa1d0_0 .net "B", 3 0, v0x57a05a5fa4c0_0;  1 drivers
v0x57a05a5fa2b0_0 .net "EQ", 0 0, L_0x57a05a5fa690;  alias, 1 drivers
L_0x57a05a5fa690 .cmp/eq 4, v0x57a05a5fa3d0_0, v0x57a05a5fa4c0_0;
    .scope S_0x57a05a5e7bb0;
T_0 ;
    %vpi_call/w 3 6 "$dumpfile", "equality.vcd" {0 0 0};
    %vpi_call/w 3 7 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x57a05a5e7bb0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x57a05a5e7bb0;
T_1 ;
    %vpi_call/w 3 10 "$monitor", "A=%b B=%b | EQ=%b", v0x57a05a5fa3d0_0, v0x57a05a5fa4c0_0, v0x57a05a5fa590_0 {0 0 0};
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x57a05a5fa3d0_0, 0, 4;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x57a05a5fa4c0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x57a05a5fa3d0_0, 0, 4;
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x57a05a5fa4c0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x57a05a5fa3d0_0, 0, 4;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x57a05a5fa4c0_0, 0, 4;
    %delay 10, 0;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x57a05a5fa3d0_0, 0, 4;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x57a05a5fa4c0_0, 0, 4;
    %delay 10, 0;
    %vpi_call/w 3 15 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "equality_tb.v";
    "equality.v";
