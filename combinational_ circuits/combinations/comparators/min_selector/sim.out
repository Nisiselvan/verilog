#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5c56ad658f60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5c56ad6590f0 .scope module, "min_selector_tb" "min_selector_tb" 3 2;
 .timescale -9 -12;
v0x5c56ad66d6b0_0 .var "a", 2 0;
v0x5c56ad66d7a0_0 .var "b", 2 0;
v0x5c56ad66d870_0 .net "min", 2 0, L_0x5c56ad66dae0;  1 drivers
S_0x5c56ad61f490 .scope module, "dut" "min_selector" 3 6, 4 1 0, S_0x5c56ad6590f0;
 .timescale 0 0;
    .port_info 0 /INPUT 3 "a";
    .port_info 1 /INPUT 3 "b";
    .port_info 2 /OUTPUT 3 "min";
v0x5c56ad61f6c0_0 .net *"_ivl_0", 0 0, L_0x5c56ad66d970;  1 drivers
v0x5c56ad66d3b0_0 .net "a", 2 0, v0x5c56ad66d6b0_0;  1 drivers
v0x5c56ad66d490_0 .net "b", 2 0, v0x5c56ad66d7a0_0;  1 drivers
v0x5c56ad66d550_0 .net "min", 2 0, L_0x5c56ad66dae0;  alias, 1 drivers
L_0x5c56ad66d970 .cmp/gt 3, v0x5c56ad66d7a0_0, v0x5c56ad66d6b0_0;
L_0x5c56ad66dae0 .functor MUXZ 3, v0x5c56ad66d7a0_0, v0x5c56ad66d6b0_0, L_0x5c56ad66d970, C4<>;
    .scope S_0x5c56ad6590f0;
T_0 ;
    %vpi_call/w 3 13 "$dumpfile", "min_selector.vcd" {0 0 0};
    %vpi_call/w 3 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5c56ad6590f0 {0 0 0};
    %vpi_call/w 3 15 "$monitor", "time=%0t | a=%b | b=%b | min=%b", $time, v0x5c56ad66d6b0_0, v0x5c56ad66d7a0_0, v0x5c56ad66d870_0 {0 0 0};
    %pushi/vec4 6, 0, 3;
    %store/vec4 v0x5c56ad66d6b0_0, 0, 3;
    %pushi/vec4 5, 0, 3;
    %store/vec4 v0x5c56ad66d7a0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 6, 0, 3;
    %store/vec4 v0x5c56ad66d6b0_0, 0, 3;
    %pushi/vec4 4, 0, 3;
    %store/vec4 v0x5c56ad66d7a0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 4, 0, 3;
    %store/vec4 v0x5c56ad66d6b0_0, 0, 3;
    %pushi/vec4 3, 0, 3;
    %store/vec4 v0x5c56ad66d7a0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 3;
    %store/vec4 v0x5c56ad66d6b0_0, 0, 3;
    %pushi/vec4 4, 0, 3;
    %store/vec4 v0x5c56ad66d7a0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 5, 0, 3;
    %store/vec4 v0x5c56ad66d6b0_0, 0, 3;
    %pushi/vec4 2, 0, 3;
    %store/vec4 v0x5c56ad66d7a0_0, 0, 3;
    %delay 10000, 0;
    %vpi_call/w 3 27 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "min_selector_tb.v";
    "min_selector.v";
