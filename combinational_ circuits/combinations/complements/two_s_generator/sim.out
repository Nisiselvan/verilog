v0x5a02db4950f0_0 .net "data", 3 0, v0x5a02db495320_0;  1 drivers
    .scope S_0x5a02db482ae0;
T_0 ;
    %vpi_call/w 3 12 "$dumpfile", "two_s_generator.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a02db482ae0 {0 0 0};
    %vpi_call/w 3 14 "$monitor", "time=%0t | data=%b | complement=%b", $time, v0x5a02db495320_0, v0x5a02db495230_0 {0 0 0};
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5a02db495320_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5a02db495320_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5a02db495320_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 24 "$finish" {0 0 0};
