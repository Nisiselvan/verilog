#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x57d4ed393e00 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x57d4ed393f90 .scope module, "decoder_3to8_tb" "decoder_3to8_tb" 3 2;
 .timescale -9 -12;
v0x57d4ed3a6400_0 .var "a", 2 0;
v0x57d4ed3a64c0_0 .net "y", 7 0, v0x57d4ed3a62c0_0;  1 drivers
S_0x57d4ed35a490 .scope module, "dut" "decoder_3to8" 3 5, 4 1 0, S_0x57d4ed393f90;
 .timescale 0 0;
    .port_info 0 /INPUT 3 "a";
    .port_info 1 /OUTPUT 8 "y";
v0x57d4ed35a690_0 .net "a", 2 0, v0x57d4ed3a6400_0;  1 drivers
v0x57d4ed3a62c0_0 .var "y", 7 0;
E_0x57d4ed35aa50 .event anyedge, v0x57d4ed35a690_0;
    .scope S_0x57d4ed35a490;
T_0 ;
    %wait E_0x57d4ed35aa50;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x57d4ed3a62c0_0, 0, 8;
    %pushi/vec4 1, 0, 1;
    %ix/getv 4, v0x57d4ed35a690_0;
    %store/vec4 v0x57d4ed3a62c0_0, 4, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x57d4ed393f90;
T_1 ;
    %vpi_call/w 3 8 "$dumpfile", "decoder_3to8.vcd" {0 0 0};
    %vpi_call/w 3 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x57d4ed393f90 {0 0 0};
    %pushi/vec4 0, 0, 3;
    %store/vec4 v0x57d4ed3a6400_0, 0, 3;
    %delay 10000, 0;
    %vpi_call/w 3 10 "$display", "a=%b y=%b", v0x57d4ed3a6400_0, v0x57d4ed3a64c0_0 {0 0 0};
    %pushi/vec4 1, 0, 3;
    %store/vec4 v0x57d4ed3a6400_0, 0, 3;
    %delay 10000, 0;
    %vpi_call/w 3 11 "$display", "a=%b y=%b", v0x57d4ed3a6400_0, v0x57d4ed3a64c0_0 {0 0 0};
    %pushi/vec4 2, 0, 3;
    %store/vec4 v0x57d4ed3a6400_0, 0, 3;
    %delay 10000, 0;
    %vpi_call/w 3 12 "$display", "a=%b y=%b", v0x57d4ed3a6400_0, v0x57d4ed3a64c0_0 {0 0 0};
    %pushi/vec4 7, 0, 3;
    %store/vec4 v0x57d4ed3a6400_0, 0, 3;
    %delay 10000, 0;
    %vpi_call/w 3 13 "$display", "a=%b y=%b", v0x57d4ed3a6400_0, v0x57d4ed3a64c0_0 {0 0 0};
    %vpi_call/w 3 14 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "decoder_3to8_tb.v";
    "decoder_3to8.v";
