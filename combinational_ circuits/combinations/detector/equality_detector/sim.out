#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5b2fa2a3a770 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5b2fa2a3a900 .scope module, "equality_detector_tb" "equality_detector_tb" 3 2;
 .timescale -9 -12;
v0x5b2fa2a4d430_0 .var "a", 0 0;
v0x5b2fa2a4d500_0 .var "b", 0 0;
v0x5b2fa2a4d5d0_0 .net "equal", 0 0, L_0x5b2fa2a4d6d0;  1 drivers
S_0x5b2fa2a01490 .scope module, "dut" "equality_detector" 3 6, 4 1 0, S_0x5b2fa2a3a900;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "equal";
L_0x5b2fa2a4d6d0 .functor XNOR 1, v0x5b2fa2a4d430_0, v0x5b2fa2a4d500_0, C4<0>, C4<0>;
v0x5b2fa2a016c0_0 .net "a", 0 0, v0x5b2fa2a4d430_0;  1 drivers
v0x5b2fa2a4d250_0 .net "b", 0 0, v0x5b2fa2a4d500_0;  1 drivers
v0x5b2fa2a4d310_0 .net "equal", 0 0, L_0x5b2fa2a4d6d0;  alias, 1 drivers
    .scope S_0x5b2fa2a3a900;
T_0 ;
    %vpi_call/w 3 12 "$dumpfile", "equality_detector.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5b2fa2a3a900 {0 0 0};
    %vpi_call/w 3 15 "$monitor", "time=%0t | a=%b | b=%b | equal=%b", $time, v0x5b2fa2a4d430_0, v0x5b2fa2a4d500_0, v0x5b2fa2a4d5d0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b2fa2a4d430_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b2fa2a4d500_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b2fa2a4d430_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5b2fa2a4d500_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b2fa2a4d430_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5b2fa2a4d500_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 23 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "equality_detector_tb.v";
    "equality_detector.v";
