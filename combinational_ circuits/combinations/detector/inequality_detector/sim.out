v0x61c831a106c0_0 .net "a", 0 0, v0x61c831a5c730_0;  1 drivers
v0x61c831a5c550_0 .net "b", 0 0, v0x61c831a5c7d0_0;  1 drivers
v0x61c831a5c610_0 .net "inequal", 0 0, L_0x61c831a5c9a0;  alias, 1 drivers
L_0x61c831a5c9a0 .cmp/nee 1, v0x61c831a5c730_0, v0x61c831a5c7d0_0;
    .scope S_0x61c831a49900;
T_0 ;
    %vpi_call/w 3 12 "$dumpfile", "inequality_detector.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x61c831a49900 {0 0 0};
    %vpi_call/w 3 15 "$monitor", "time=%0t | a=%b | b=%b | equal=%b", $time, v0x61c831a5c730_0, v0x61c831a5c7d0_0, v0x61c831a5c8a0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61c831a5c730_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61c831a5c7d0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61c831a5c730_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61c831a5c7d0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61c831a5c730_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61c831a5c7d0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 23 "$finish" {0 0 0};
    %end;
    .thread T_0;
