#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x58f360510be0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x58f360510d70 .scope module, "even_parity_generator_tb" "even_parity_generator_tb" 3 2;
 .timescale -9 -12;
v0x58f360525710_0 .var "data", 3 0;
v0x58f3605257d0_0 .net "parity", 0 0, L_0x58f360525dd0;  1 drivers
S_0x58f3604d7490 .scope module, "dut" "even_parity_generator" 3 6, 4 1 0, S_0x58f360510d70;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "data";
    .port_info 1 /OUTPUT 1 "parity";
L_0x58f360525a60 .functor XOR 1, L_0x58f3605258a0, L_0x58f3605259c0, C4<0>, C4<0>;
L_0x58f360525c40 .functor XOR 1, L_0x58f360525a60, L_0x58f360525ba0, C4<0>, C4<0>;
L_0x58f360525dd0 .functor XOR 1, L_0x58f360525c40, L_0x58f360525d00, C4<0>, C4<0>;
v0x58f3604d7670_0 .net *"_ivl_1", 0 0, L_0x58f3605258a0;  1 drivers
v0x58f360525080_0 .net *"_ivl_11", 0 0, L_0x58f360525d00;  1 drivers
v0x58f360525160_0 .net *"_ivl_3", 0 0, L_0x58f3605259c0;  1 drivers
v0x58f360525220_0 .net *"_ivl_4", 0 0, L_0x58f360525a60;  1 drivers
v0x58f360525300_0 .net *"_ivl_7", 0 0, L_0x58f360525ba0;  1 drivers
v0x58f360525430_0 .net *"_ivl_8", 0 0, L_0x58f360525c40;  1 drivers
v0x58f360525510_0 .net "data", 3 0, v0x58f360525710_0;  1 drivers
v0x58f3605255f0_0 .net "parity", 0 0, L_0x58f360525dd0;  alias, 1 drivers
L_0x58f3605258a0 .part v0x58f360525710_0, 3, 1;
L_0x58f3605259c0 .part v0x58f360525710_0, 2, 1;
L_0x58f360525ba0 .part v0x58f360525710_0, 1, 1;
L_0x58f360525d00 .part v0x58f360525710_0, 0, 1;
    .scope S_0x58f360510d70;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "even_parity_generator.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x58f360510d70 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x58f360510d70;
T_1 ;
    %vpi_call/w 3 16 "$monitor", "time=%0t | data=%b | parity=%b", $time, v0x58f360525710_0, v0x58f3605257d0_0 {0 0 0};
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x58f360525710_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x58f360525710_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x58f360525710_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v0x58f360525710_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 26 "$finish" {0 0 0};
    %end;
    .thread T_1;
