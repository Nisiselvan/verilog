#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x625fc13e9690 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x625fc13fcb90 .scope module, "mux_8to1_tb" "mux_8to1_tb" 3 3;
 .timescale -9 -12;
v0x625fc1410be0_0 .var "a", 7 0;
v0x625fc1410cd0_0 .var "sel", 2 0;
v0x625fc1410da0_0 .net "y", 0 0, L_0x625fc1410ea0;  1 drivers
S_0x625fc13fcd20 .scope module, "dut" "mux_8to1" 3 9, 4 1 0, S_0x625fc13fcb90;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 3 "sel";
    .port_info 2 /OUTPUT 1 "y";
v0x625fc13fcf50_0 .net "a", 7 0, v0x625fc1410be0_0;  1 drivers
v0x625fc14109e0_0 .net "sel", 2 0, v0x625fc1410cd0_0;  1 drivers
v0x625fc1410ac0_0 .net "y", 0 0, L_0x625fc1410ea0;  alias, 1 drivers
L_0x625fc1410ea0 .part/v v0x625fc1410be0_0, v0x625fc1410cd0_0, 1;
    .scope S_0x625fc13fcb90;
T_0 ;
    %vpi_call/w 3 16 "$dumpfile", "mux_8to1.vcd" {0 0 0};
    %vpi_call/w 3 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x625fc13fcb90 {0 0 0};
    %vpi_call/w 3 19 "$monitor", "time=%0t | a=%b | sel=%b | y=%b", $time, v0x625fc1410be0_0, v0x625fc1410cd0_0, v0x625fc1410da0_0 {0 0 0};
    %pushi/vec4 166, 0, 8;
    %store/vec4 v0x625fc1410be0_0, 0, 8;
    %pushi/vec4 0, 0, 3;
    %store/vec4 v0x625fc1410cd0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 3;
    %store/vec4 v0x625fc1410cd0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 3;
    %store/vec4 v0x625fc1410cd0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 3;
    %store/vec4 v0x625fc1410cd0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 4, 0, 3;
    %store/vec4 v0x625fc1410cd0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 5, 0, 3;
    %store/vec4 v0x625fc1410cd0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 6, 0, 3;
    %store/vec4 v0x625fc1410cd0_0, 0, 3;
    %delay 10000, 0;
    %pushi/vec4 7, 0, 3;
    %store/vec4 v0x625fc1410cd0_0, 0, 3;
    %delay 10000, 0;
    %vpi_call/w 3 33 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "mux_8to1_tb.v";
