#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5ca52f8a9770 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5ca52f8a9900 .scope module, "even_parity_checker_tb" "even_parity_checker_tb" 3 2;
 .timescale -9 -12;
v0x5ca52f8bb3e0_0 .var "data", 4 0;
v0x5ca52f8bb4a0_0 .net "error", 0 0, L_0x5ca52f8bb570;  1 drivers
S_0x5ca52f870490 .scope module, "dut" "even_parity_checker" 3 5, 4 1 0, S_0x5ca52f8a9900;
 .timescale 0 0;
    .port_info 0 /INPUT 5 "data";
    .port_info 1 /OUTPUT 1 "error";
v0x5ca52f870670_0 .net "data", 4 0, v0x5ca52f8bb3e0_0;  1 drivers
v0x5ca52f8bb2c0_0 .net "error", 0 0, L_0x5ca52f8bb570;  alias, 1 drivers
L_0x5ca52f8bb570 .reduce/xor v0x5ca52f8bb3e0_0;
    .scope S_0x5ca52f8a9900;
T_0 ;
    %vpi_call/w 3 8 "$dumpfile", "even_parity_checker.vcd" {0 0 0};
    %vpi_call/w 3 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5ca52f8a9900 {0 0 0};
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x5ca52f8bb3e0_0, 0, 5;
    %delay 10000, 0;
    %vpi_call/w 3 10 "$display", "data=%b error=%b", v0x5ca52f8bb3e0_0, v0x5ca52f8bb4a0_0 {0 0 0};
    %pushi/vec4 1, 0, 5;
    %store/vec4 v0x5ca52f8bb3e0_0, 0, 5;
    %delay 10000, 0;
    %vpi_call/w 3 11 "$display", "data=%b error=%b", v0x5ca52f8bb3e0_0, v0x5ca52f8bb4a0_0 {0 0 0};
    %pushi/vec4 21, 0, 5;
    %store/vec4 v0x5ca52f8bb3e0_0, 0, 5;
    %delay 10000, 0;
    %vpi_call/w 3 12 "$display", "data=%b error=%b", v0x5ca52f8bb3e0_0, v0x5ca52f8bb4a0_0 {0 0 0};
    %vpi_call/w 3 13 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "even_parity_checker_tb.v";
    "even_parity_checker.v";
