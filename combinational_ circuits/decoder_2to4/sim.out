#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5f75fc7fc6e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5f75fc7fc870 .scope module, "decoder_2to4_tb" "decoder_2to4_tb" 3 4;
 .timescale -9 -12;
v0x5f75fc80f5c0_0 .var "a", 1 0;
v0x5f75fc80f680_0 .net "y", 3 0, v0x5f75fc80f480_0;  1 drivers
S_0x5f75fc7c2490 .scope module, "dut" "decoder_2to4" 3 9, 4 2 0, S_0x5f75fc7fc870;
 .timescale 0 0;
    .port_info 0 /INPUT 2 "a";
    .port_info 1 /OUTPUT 4 "y";
v0x5f75fc7c2690_0 .net "a", 1 0, v0x5f75fc80f5c0_0;  1 drivers
v0x5f75fc80f480_0 .var "y", 3 0;
E_0x5f75fc7c2ec0 .event anyedge, v0x5f75fc7c2690_0;
    .scope S_0x5f75fc7c2490;
T_0 ;
    %wait E_0x5f75fc7c2ec0;
    %load/vec4 v0x5f75fc7c2690_0;
    %dup/vec4;
    %pushi/vec4 0, 0, 2;
    %cmp/u;
    %jmp/1 T_0.0, 6;
    %dup/vec4;
    %pushi/vec4 1, 0, 2;
    %cmp/u;
    %jmp/1 T_0.1, 6;
    %dup/vec4;
    %pushi/vec4 2, 0, 2;
    %cmp/u;
    %jmp/1 T_0.2, 6;
    %dup/vec4;
    %pushi/vec4 3, 0, 2;
    %cmp/u;
    %jmp/1 T_0.3, 6;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5f75fc80f480_0, 0, 4;
    %jmp T_0.5;
T_0.0 ;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5f75fc80f480_0, 0, 4;
    %jmp T_0.5;
T_0.1 ;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5f75fc80f480_0, 0, 4;
    %jmp T_0.5;
T_0.2 ;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x5f75fc80f480_0, 0, 4;
    %jmp T_0.5;
T_0.3 ;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x5f75fc80f480_0, 0, 4;
    %jmp T_0.5;
T_0.5 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5f75fc7fc870;
T_1 ;
    %vpi_call/w 3 15 "$dumpfile", "decoder_2to4.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5f75fc7fc870 {0 0 0};
    %vpi_call/w 3 17 "$display", "Time\011 a\011 y" {0 0 0};
    %vpi_call/w 3 18 "$monitor", "%0t\011 %b\011 %b", $time, v0x5f75fc80f5c0_0, v0x5f75fc80f680_0 {0 0 0};
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5f75fc80f5c0_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5f75fc80f5c0_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x5f75fc80f5c0_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x5f75fc80f5c0_0, 0, 2;
    %delay 10000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "decoder_2to4_tb.v";
    "decoder_2to4.v";
