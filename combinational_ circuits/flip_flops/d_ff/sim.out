#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x57d2021259a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x57d202125b30 .scope module, "d_ff_tb" "d_ff_tb" 3 3;
 .timescale -9 -12;
v0x57d20213a340_0 .var "clk", 0 0;
v0x57d20213a400_0 .var "d", 0 0;
v0x57d20213a4d0_0 .net "q", 0 0, v0x57d20213a000_0;  1 drivers
v0x57d20213a5d0_0 .net "q_bar", 0 0, L_0x57d20213a790;  1 drivers
v0x57d20213a6a0_0 .var "reset", 0 0;
S_0x57d2020eb490 .scope module, "dut" "d_ff" 3 11, 4 1 0, S_0x57d202125b30;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "d";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /INPUT 1 "reset";
    .port_info 3 /OUTPUT 1 "q";
    .port_info 4 /OUTPUT 1 "q_bar";
L_0x57d20213a790 .functor NOT 1, v0x57d20213a000_0, C4<0>, C4<0>, C4<0>;
v0x57d2020eb690_0 .net "clk", 0 0, v0x57d20213a340_0;  1 drivers
v0x57d202139f40_0 .net "d", 0 0, v0x57d20213a400_0;  1 drivers
v0x57d20213a000_0 .var "q", 0 0;
v0x57d20213a0d0_0 .net "q_bar", 0 0, L_0x57d20213a790;  alias, 1 drivers
v0x57d20213a190_0 .net "reset", 0 0, v0x57d20213a6a0_0;  1 drivers
E_0x57d2020ff640 .event posedge, v0x57d2020eb690_0;
    .scope S_0x57d2020eb490;
T_0 ;
    %wait E_0x57d2020ff640;
    %load/vec4 v0x57d20213a190_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x57d20213a000_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x57d202139f40_0;
    %assign/vec4 v0x57d20213a000_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x57d202125b30;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x57d20213a340_0;
    %inv;
    %store/vec4 v0x57d20213a340_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x57d202125b30;
T_2 ;
    %vpi_call/w 3 22 "$dumpfile", "d_ff.vcd" {0 0 0};
    %vpi_call/w 3 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x57d202125b30 {0 0 0};
    %vpi_call/w 3 24 "$monitor", "time=%0dns | reset=%b | d=%b | q=%b | q_bar=%b", $time, v0x57d20213a6a0_0, v0x57d20213a400_0, v0x57d20213a4d0_0, v0x57d20213a5d0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57d20213a340_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57d20213a6a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57d20213a400_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57d20213a6a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57d20213a400_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57d20213a400_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57d20213a400_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 41 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "d_ff_tb.v";
