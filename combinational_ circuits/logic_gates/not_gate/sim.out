#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5e38b8ee9fc0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5e38b8efd770 .scope module, "not_gate_tb" "not_gate_tb" 3 3;
 .timescale -9 -12;
v0x5e38b8f0ea50_0 .var "a", 0 0;
v0x5e38b8f0eaf0_0 .net "y", 0 0, L_0x5e38b8f0ebc0;  1 drivers
S_0x5e38b8efd900 .scope module, "dut" "not_gate" 3 8, 4 1 0, S_0x5e38b8efd770;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x5e38b8f0ebc0 .functor NOT 1, v0x5e38b8f0ea50_0, C4<0>, C4<0>, C4<0>;
v0x5e38b8efdae0_0 .net "a", 0 0, v0x5e38b8f0ea50_0;  1 drivers
v0x5e38b8f0e930_0 .net "y", 0 0, L_0x5e38b8f0ebc0;  alias, 1 drivers
    .scope S_0x5e38b8efd770;
T_0 ;
    %vpi_call/w 3 13 "$dumpfile", "not_gate.vcd" {0 0 0};
    %vpi_call/w 3 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e38b8efd770 {0 0 0};
    %vpi_call/w 3 16 "$monitor", "time=%0t a=%b b=%b y=%b", $time, v0x5e38b8f0ea50_0, v0x5e38b8f0eaf0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e38b8f0ea50_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e38b8f0ea50_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 22 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "not_gate_tb.v";
    "not_gate.v";
