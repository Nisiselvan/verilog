#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5ac6ccd8a220 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5ac6ccd8a3b0 .scope module, "johnson_counter_tb" "johnson_counter_tb" 3 2;
 .timescale -9 -12;
v0x5ac6ccd9d3c0_0 .var "clk", 0 0;
v0x5ac6ccd9d490_0 .net "q", 3 0, v0x5ac6ccd9d1c0_0;  1 drivers
v0x5ac6ccd9d560_0 .var "rst", 0 0;
S_0x5ac6ccd50490 .scope module, "dut" "johnson_counter" 3 7, 4 1 0, S_0x5ac6ccd8a3b0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 4 "q";
v0x5ac6ccd506e0_0 .net "clk", 0 0, v0x5ac6ccd9d3c0_0;  1 drivers
v0x5ac6ccd9d1c0_0 .var "q", 3 0;
v0x5ac6ccd9d2a0_0 .net "rst", 0 0, v0x5ac6ccd9d560_0;  1 drivers
E_0x5ac6ccd50ae0 .event posedge, v0x5ac6ccd506e0_0;
    .scope S_0x5ac6ccd50490;
T_0 ;
    %wait E_0x5ac6ccd50ae0;
    %load/vec4 v0x5ac6ccd9d2a0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 8, 0, 4;
    %assign/vec4 v0x5ac6ccd9d1c0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5ac6ccd9d1c0_0;
    %parti/s 1, 0, 2;
    %inv;
    %load/vec4 v0x5ac6ccd9d1c0_0;
    %parti/s 3, 1, 2;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x5ac6ccd9d1c0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5ac6ccd8a3b0;
T_1 ;
    %delay 10000, 0;
    %load/vec4 v0x5ac6ccd9d3c0_0;
    %inv;
    %store/vec4 v0x5ac6ccd9d3c0_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x5ac6ccd8a3b0;
T_2 ;
    %vpi_call/w 3 14 "$dumpfile", "johnson_counter.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5ac6ccd8a3b0 {0 0 0};
    %vpi_call/w 3 17 "$monitor", "time=%0t | clk=%b | rst=%b | q=%b", $time, v0x5ac6ccd9d3c0_0, v0x5ac6ccd9d560_0, v0x5ac6ccd9d490_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5ac6ccd9d3c0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5ac6ccd9d560_0, 0, 1;
    %delay 20000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5ac6ccd9d560_0, 0, 1;
    %delay 100000, 0;
    %vpi_call/w 3 24 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "johnson_counter_tb.v";
    "johnson_counter.v";
