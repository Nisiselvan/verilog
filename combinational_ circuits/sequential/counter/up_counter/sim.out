#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x6368c402bf90 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x6368c402c120 .scope module, "up_counter_tb" "up_counter_tb" 3 3;
 .timescale -9 -12;
v0x6368c403ec00_0 .var "clk", 0 0;
v0x6368c403ecd0_0 .net "q", 2 0, v0x6368c403ea00_0;  1 drivers
v0x6368c403eda0_0 .var "rst", 0 0;
S_0x6368c3ff2490 .scope module, "dut" "up_counter" 3 7, 4 1 0, S_0x6368c402c120;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 3 "q";
v0x6368c3ff26c0_0 .net "clk", 0 0, v0x6368c403ec00_0;  1 drivers
v0x6368c403ea00_0 .var "q", 2 0;
v0x6368c403eae0_0 .net "rst", 0 0, v0x6368c403eda0_0;  1 drivers
E_0x6368c4006640 .event posedge, v0x6368c3ff26c0_0;
    .scope S_0x6368c3ff2490;
T_0 ;
    %wait E_0x6368c4006640;
    %load/vec4 v0x6368c403eae0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 3;
    %assign/vec4 v0x6368c403ea00_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x6368c403ea00_0;
    %addi 1, 0, 3;
    %assign/vec4 v0x6368c403ea00_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x6368c402c120;
T_1 ;
    %delay 10000, 0;
    %load/vec4 v0x6368c403ec00_0;
    %inv;
    %store/vec4 v0x6368c403ec00_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x6368c402c120;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6368c403ec00_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x6368c403eda0_0, 0, 1;
    %vpi_call/w 3 18 "$dumpfile", "up_counter.vcd" {0 0 0};
    %vpi_call/w 3 19 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6368c402c120 {0 0 0};
    %vpi_call/w 3 21 "$monitor", "$time=%0t | clk=%b | rst=%b | q=%b", $time, v0x6368c403ec00_0, v0x6368c403eda0_0, v0x6368c403ecd0_0 {0 0 0};
    %delay 20000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6368c403eda0_0, 0, 1;
    %delay 100000, 0;
    %vpi_call/w 3 26 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "up_counter_tb.v";
    "up_counter.v";
