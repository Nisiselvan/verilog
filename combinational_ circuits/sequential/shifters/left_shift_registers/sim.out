:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x61cd37d573f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x61cd37d57580 .scope module, "left_shift_register_tb" "left_shift_register_tb" 3 3;
 .timescale -9 -12;
v0x61cd37d6bb70_0 .var "a", 3 0;
v0x61cd37d6bc50_0 .var "clk", 0 0;
v0x61cd37d6bd20_0 .net "q", 3 0, v0x61cd37d6b910_0;  1 drivers
v0x61cd37d6be20_0 .var "rst", 0 0;
S_0x61cd37d1d490 .scope module, "dut" "left_shift_register" 3 10, 4 1 0, S_0x61cd37d57580;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 4 "a";
    .port_info 3 /OUTPUT 4 "q";
v0x61cd37d1d700_0 .net "a", 3 0, v0x61cd37d6bb70_0;  1 drivers
v0x61cd37d6b850_0 .net "clk", 0 0, v0x61cd37d6bc50_0;  1 drivers
v0x61cd37d6b910_0 .var "q", 3 0;
v0x61cd37d6ba00_0 .net "rst", 0 0, v0x61cd37d6be20_0;  1 drivers
E_0x61cd37d1df20 .event posedge, v0x61cd37d6b850_0;
    .scope S_0x61cd37d1d490;
T_0 ;
    %wait E_0x61cd37d1df20;
    %load/vec4 v0x61cd37d6ba00_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x61cd37d6b910_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x61cd37d1d700_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftl 4;
    %assign/vec4 v0x61cd37d6b910_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x61cd37d57580;
T_1 ;
    %delay 10000, 0;
    %load/vec4 v0x61cd37d6bc50_0;
    %inv;
    %store/vec4 v0x61cd37d6bc50_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x61cd37d57580;
T_2 ;
    %vpi_call/w 3 20 "$dumpfile", "left_shift_register.vcd" {0 0 0};
    %vpi_call/w 3 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x61cd37d57580 {0 0 0};
    %vpi_call/w 3 23 "$monitor", "time=%0t | a=%b | q=%b", $time, v0x61cd37d6bb70_0, v0x61cd37d6bd20_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61cd37d6bc50_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61cd37d6be20_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x61cd37d6bb70_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61cd37d6be20_0, 0, 1;
    %pushi/vec4 14, 0, 4;
    %store/vec4 v0x61cd37d6bb70_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x61cd37d6bb70_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x61cd37d6bb70_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 41 "$finish" {0 0 0};
    %end;
    .thread T_2;
