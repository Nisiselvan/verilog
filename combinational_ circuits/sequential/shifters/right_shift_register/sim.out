#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5d9c826083f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5d9c82608580 .scope module, "right_shift_register_tb" "right_shift_register_tb" 3 3;
 .timescale -9 -12;
v0x5d9c8261cbb0_0 .var "a", 3 0;
v0x5d9c8261cc90_0 .var "clk", 0 0;
v0x5d9c8261cd60_0 .net "q", 3 0, v0x5d9c8261c950_0;  1 drivers
v0x5d9c8261ce60_0 .var "rst", 0 0;
S_0x5d9c825ce490 .scope module, "dut" "right_shift_register" 3 10, 4 1 0, S_0x5d9c82608580;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 4 "a";
    .port_info 3 /OUTPUT 4 "q";
v0x5d9c825ce700_0 .net "a", 3 0, v0x5d9c8261cbb0_0;  1 drivers
v0x5d9c8261c890_0 .net "clk", 0 0, v0x5d9c8261cc90_0;  1 drivers
v0x5d9c8261c950_0 .var "q", 3 0;
v0x5d9c8261ca40_0 .net "rst", 0 0, v0x5d9c8261ce60_0;  1 drivers
E_0x5d9c825cef20 .event posedge, v0x5d9c8261c890_0;
    .scope S_0x5d9c825ce490;
T_0 ;
    %wait E_0x5d9c825cef20;
    %load/vec4 v0x5d9c8261ca40_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x5d9c8261c950_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5d9c825ce700_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftr 4;
    %assign/vec4 v0x5d9c8261c950_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5d9c82608580;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x5d9c8261cc90_0;
    %inv;
    %store/vec4 v0x5d9c8261cc90_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x5d9c82608580;
T_2 ;
    %vpi_call/w 3 20 "$dumpfile", "right_shift_register.vcd" {0 0 0};
    %vpi_call/w 3 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5d9c82608580 {0 0 0};
    %vpi_call/w 3 23 "$monitor", "time=%0t | a=%b | q=%b", $time, v0x5d9c8261cbb0_0, v0x5d9c8261cd60_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d9c8261cc90_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d9c8261ce60_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5d9c8261cbb0_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d9c8261ce60_0, 0, 1;
    %pushi/vec4 14, 0, 4;
    %store/vec4 v0x5d9c8261cbb0_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x5d9c8261cbb0_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 10, 0, 4;
    %store/vec4 v0x5d9c8261cbb0_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 41 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "right_shift_register_tb.v";
    "right_shift_register.v";
